# ──────────────────────────────────────────
# App
# ──────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ──────────────────────────────────────────
# Database
# ──────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://jobpilot:jobpilot@localhost:5432/jobpilot
DATABASE_URL_ASYNC=postgresql+asyncpg://jobpilot:jobpilot@localhost:5432/jobpilot

# ──────────────────────────────────────────
# Business Rules
# ──────────────────────────────────────────
# 관심기업 최대 등록 수 (기본값 5, 환경변수로 오버라이드 가능)
SUBSCRIPTION_LIMIT=5

# ──────────────────────────────────────────
# News Collection (Phase 1)
# ──────────────────────────────────────────
# 사용할 뉴스 provider (현재 지원: naver)
NEWS_PROVIDER=naver

# 네이버 오픈API 인증 정보
# 발급: https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 배치 수집 기본 설정
NEWS_DEFAULT_LIMIT=5      # 기업당 최대 수집 기사 수
NEWS_LOOKBACK_DAYS=3      # 최근 며칠치 기준 (로그 표시용)

# ──────────────────────────────────────────
# Briefing Generation (Phase 2)
# ──────────────────────────────────────────
# 브리핑에 포함할 최근 뉴스 기준 일수 (기본 3일)
BRIEFING_NEWS_LOOKBACK_DAYS=3

# 기업당 최대 브리핑 아이템 수 (기본 2개)
BRIEFING_MAX_ITEMS_PER_COMPANY=2

# 사용자당 최대 반영 기업 수 (기본 5개, SUBSCRIPTION_LIMIT과 동일)
BRIEFING_MAX_COMPANIES_PER_USER=5

# ──────────────────────────────────────────
# Job Posting Collection (Phase 3)
# ──────────────────────────────────────────
# 사용할 채용공고 provider (현재 지원: saramin)
JOB_PROVIDER=saramin

# 사람인 오픈API 인증키
# 발급: https://oapi.saramin.co.kr/ → 회원가입 → API 키 신청
SARAMIN_API_KEY=

# 배치 수집 기본 설정
JOB_DEFAULT_LIMIT=5       # 기업당 최대 수집 공고 수
JOB_LOOKBACK_DAYS=30      # 최근 며칠치 기준

# rule-based 키워드 목록 (쉼표 구분, 공고 텍스트 매칭에 사용)
JOB_KEYWORDS=Python,SQL,데이터,AI,금융,협업

# ──────────────────────────────────────────
# Prep Snapshot Generation (Phase 4)
# ──────────────────────────────────────────
# 생성 대상 정책: subscriptions (관심기업만) | all (전체 기업)
# MVP에서는 subscriptions 권장 – 불필요한 연산 방지
PREP_TARGET_MODE=subscriptions

# snapshot 생성 시 사용할 뉴스 조회 범위 (기본 7일)
PREP_NEWS_LOOKBACK_DAYS=7

# snapshot 생성 시 사용할 최대 뉴스 건수 (기본 3건)
PREP_MAX_NEWS_ITEMS=3

# snapshot 생성 시 사용할 최대 채용공고 건수 (기본 3건)
PREP_MAX_JOB_ITEMS=3

# 생성 정책: daily (하루 1개, 기본) | always (매번 새 snapshot 생성)
PREP_GENERATION_MODE=daily

# ──────────────────────────────────────────
# JWT Authentication (Phase 5)
# ──────────────────────────────────────────
# 운영 환경에서는 반드시 강력한 랜덤 키로 교체할 것
# 생성 방법: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_KEY

# JWT 서명 알고리즘 (변경 불필요)
JWT_ALGORITHM=HS256

# Access token 유효 시간 (분 단위, 기본 60분)
ACCESS_TOKEN_EXPIRE_MINUTES=60

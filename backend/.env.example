# ──────────────────────────────────────────
# App
# ──────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ──────────────────────────────────────────
# Database
# ──────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://jobpilot:jobpilot@localhost:5432/jobpilot
DATABASE_URL_ASYNC=postgresql+asyncpg://jobpilot:jobpilot@localhost:5432/jobpilot

# ──────────────────────────────────────────
# Business Rules
# ──────────────────────────────────────────
# 관심기업 최대 등록 수 (기본값 5, 환경변수로 오버라이드 가능)
SUBSCRIPTION_LIMIT=5

# ──────────────────────────────────────────
# Auth (Phase 1에서 JWT로 교체)
# ──────────────────────────────────────────
# 현재는 fake user 사용. JWT 도입 시 아래 값 활성화
# SECRET_KEY=your-secret-key-here
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
